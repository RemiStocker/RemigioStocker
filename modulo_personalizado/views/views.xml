<odoo>
  <data>
    <!-- Tree/List -->
    <record id="view_modulo_personalizado_tree" model="ir.ui.view">
      <field name="name">modulo_personalizado.tree</field>
      <field name="model">modulo_personalizado.modulo_personalizado</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="value"/>
          <field name="value2"/>
        </tree>
      </field>
    </record>

    <!-- Form -->
    <record id="view_modulo_personalizado_form" model="ir.ui.view">
      <field name="name">modulo_personalizado.form</field>
      <field name="model">modulo_personalizado.modulo_personalizado</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="value"/>
              <field name="value2" readonly="1"/>
              <field name="description"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Acción -->
    <record id="action_modulo_personalizado" model="ir.actions.act_window">
      <field name="name">Registros</field>
      <field name="res_model">modulo_personalizado.modulo_personalizado</field>
      <field name="view_mode">tree,form</field>
    </record>

    <!-- Menús -->
    <menuitem id="menu_modulo_personalizado_root" name="Módulo Personalizado" sequence="10"/>
    <menuitem id="menu_modulo_personalizado_items" name="Registros"
              parent="menu_modulo_personalizado_root" action="action_modulo_personalizado" sequence="10"/>
  </data>
</odoo>
